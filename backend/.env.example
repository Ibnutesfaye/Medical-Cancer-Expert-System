# ══════════════════════════════════════════════════════════════
# Medical Cancer Expert System — Environment Configuration
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── LLM API Keys ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here    # optional fallback

# ── Database ──────────────────────────────────────────────────
# MySQL (production):
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medical_cancer_expert
# SQLite (development, no MySQL needed):
# DATABASE_URL=sqlite:///./medical_chatbot.db

# ── Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── Admin Credentials ─────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── RAG Pipeline ─────────────────────────────────────────────
RAG_MODEL_NAME=llama-3.3-70b-versatile
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=4096
RAG_MAX_HISTORY_PAIRS=10
RAG_CONTEXT_HISTORY_PAIRS=3

# ── Embedding ─────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector DB ─────────────────────────────────────────────────
VECTOR_DB_PATH=./chroma_db

# ── External Search Fallback ──────────────────────────────────
FALLBACK_ENABLED=true

# ── Security ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── MySQL (for Docker Compose) ────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword

# ── Differential Privacy (optional) ──────────────────────────
DP_TARGET_EPSILON=8.0
DP_TARGET_DELTA=1e-5
DP_MAX_GRAD_NORM=1.0

# ── Federated Learning (optional) ────────────────────────────
FL_SERVER_ADDRESS=0.0.0.0:8080
FL_NUM_ROUNDS=20
FL_MIN_CLIENTS=2

# ── Concrete ML (optional) ───────────────────────────────────
FHE_N_BITS=8
FHE_MODEL_DIR=./ai/concrete_ml/models
